# 火山方舟：LLM 与 Seedream 共用，仅服务端读取
ARK_API_KEY=
ARK_CHAT_MODEL=deepseek-v4-pro-ga-260813
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_TRYON_MODEL=doubao-seedream-5-0-260128

# 火山引擎豆包语音，仅服务端读取
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# 新版控制台 API Key 留空；仅旧鉴权明确要求时填写 Bearer
VOLCENGINE_TTS_KEY_PREFIX=

# 可在控制台试听后覆盖默认音色
TTS_SPEAKER_ZHIXIA=zh_female_santongyongns_saturn_bigtts
TTS_SPEAKER_KEKE=zh_female_meilinvyou_saturn_bigtts
TTS_SPEAKER_WANQING=zh_female_vv_uranus_bigtts
TTS_SPEAKER_XIAOMAN=zh_female_mizai_saturn_bigtts

# Neon Postgres 与 Managed Better Auth，仅服务端读取
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# 至少 32 个字符；本地可用：openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# 每日情话定时任务鉴权，仅服务端读取；生成方式：openssl rand -hex 32
# 调用 /api/cron/daily-email 时，请求头使用 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Resend 邮件服务，仅服务端读取；禁止使用 NEXT_PUBLIC_ 前缀
RESEND_API_KEY=
# 使用 onboarding@resend.dev 时，填写 Resend 账号邮箱；留空会停止每日邮件任务
DAILY_EMAIL_TEST_RECIPIENT=

# Crisp 客服窗口的公开 Website ID（不是 API 密钥），浏览器端读取
NEXT_PUBLIC_CRISP_WEBSITE_ID=
